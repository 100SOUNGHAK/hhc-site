// ─────────────────────────────────────────────────────────────────────────────
// Happy Home Care — Firebase Storage(사진·영상) 보안 규칙 (보안 강화 3단계, 2026-11-09)
//
// 적용: Firebase 콘솔 → Storage → Rules 탭에 그대로 붙여 넣고 「게시」.
//
// 설계:
//  · 읽기는 공개. 고객 보고서·인보이스가 사진을 다운로드 주소(토큰 포함)로 보여 주므로 읽기를 막을 이유가 없고,
//    막으면 예전에 발송한 문서의 사진이 깨진다.
//  · 쓰기(업로드·삭제)는 관리자만. 예외는 홈페이지 리뷰 사진(reviews/ 경로): 누구나 올릴 수 있되 이미지·5MB 이하만,
//    삭제·덮어쓰기는 관리자만.
//  · 관리자 화면 업로드 경로: inspections/ · invoices/ · contracts/ · promos/ · memo 사진 등 → 전부 아래 「그 밖의 전부」에 해당.
// ─────────────────────────────────────────────────────────────────────────────
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email.lower() in [
          'kopeco100@gmail.com'
        ];
    }

    // 홈페이지 리뷰 사진: 누구나 새로 올릴 수 있음(이미지 · 5MB 이하), 수정·삭제는 관리자
    match /reviews/{file} {
      allow read: if true;
      allow create: if request.resource != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow update, delete: if isAdmin();
    }

    // 그 밖의 전부: 읽기 공개, 쓰기는 관리자만
    match /{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
